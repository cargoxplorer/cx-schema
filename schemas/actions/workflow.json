{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "workflow Action",
  "type": "object",
  "properties": {
    "workflow": {
      "type": "object",
      "properties": {
        "workflowId": { "type": "string", "description": "Workflow identifier" },
        "inputs": { "type": "object", "description": "Workflow inputs" },
        "waitForCompletion": { "type": "boolean", "description": "Wait for an asynchronous execution to finish before resolving the action" },
        "pollInterval": { "oneOf": [{ "type": "number" }, { "type": "string" }], "description": "Polling interval in milliseconds or as a duration such as 2s" },
        "timeout": { "oneOf": [{ "type": "number" }, { "type": "string" }], "description": "Maximum wait in milliseconds or as a duration such as 5m" },
        "onStart": { "$ref": "../schemas.json#/definitions/actionsList", "description": "Actions run after the execution is created; receives executionId" },
        "onSuccess": { "$ref": "../schemas.json#/definitions/actionsList" },
        "onError": { "$ref": "../schemas.json#/definitions/actionsList" }
      },
      "x-examples": [
        {
          "workflowId": "b7c4ffa9-bf7e-4e2c-8e57-8f24f4a2b8a8",
          "inputs": { "request": { "message": "Hello, World!" } },
          "onSuccess": [{ "notification": { "message": "Echo executed successfully. {{ response.echo.message }}" } }]
        }
      ]
    }
  },
  "additionalProperties": false
}
