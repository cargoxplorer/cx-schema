{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generic CXTMS App Component",
  "type": "object",
  "description": "Base schema for any CXTMS component that can be used within the application",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name in format 'ModuleName/ComponentName'",
      "pattern": "^[A-Za-z0-9]+/[A-Za-z0-9]+$"
    },
    "permissions": {
      "$ref": "../schemas.json#/definitions/permissions"
    },
    "priority": {
      "type": "integer",
      "default": 0,
      "description": "Component priority (higher number = higher priority)"
    },
    "displayName": {
      "$ref": "../schemas.json#/definitions/localized"
    },
    "props": {
      "oneOf": [
        {
          "type": "object",
          "description": "Properties passed to the component when targeting a slot",
          "properties": {
            "targetSlot": {
              "type": "string",
              "description": "Name of the slot this component targets"
            },
            "order": {
              "type": "integer",
              "description": "Order of the component in the target slot"
            },
            "assistantContext": {
              "type": "object",
              "description": "Live structured context published to the AI Assistant while this component is mounted",
              "properties": {
                "kind": { "type": "string", "enum": ["page", "record", "dialog"] },
                "name": { "$ref": "../schemas.json#/definitions/localized" },
                "icon": { "type": "string" },
                "data": { "type": "object", "additionalProperties": true },
                "questions": {
                  "type": "array",
                  "maxItems": 5,
                  "items": { "$ref": "../schemas.json#/definitions/localized" }
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "platforms": {
      "type": "array",
      "description": "Target platforms for this component",
      "items": {
        "type": "string",
        "enum": ["web", "mobile"]
      }
    },
    "layout": {
      "$ref": "../schemas.json#/definitions/component"
    }
  },
  "required": ["name", "layout"]
}
