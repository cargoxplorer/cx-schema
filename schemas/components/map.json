{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Map Component",
  "type": "object",
  "properties": {
    "component": {
      "type": "string",
      "const": "map"
    },
    "name": {
      "type": "string",
      "description": "Unique name identifier for the map instance"
    },
    "props": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["google"],
          "default": "google",
          "description": "Map provider. Only Google Maps is currently supported."
        },
        "height": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "string",
              "pattern": "\\{\\{.*\\}\\}",
              "description": "Template expression that resolves to a numeric height"
            }
          ],
          "default": 520,
          "description": "Map viewport height in pixels"
        },
        "center": {
          "type": "object",
          "description": "Optional map center. Values can be numbers or numeric strings.",
          "properties": {
            "lat": {
              "oneOf": [{ "type": "number" }, { "type": "string" }]
            },
            "lng": {
              "oneOf": [{ "type": "number" }, { "type": "string" }]
            }
          },
          "required": ["lat", "lng"]
        },
        "zoom": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "string",
              "pattern": "\\{\\{.*\\}\\}",
              "description": "Template expression that resolves to a numeric zoom"
            }
          ],
          "description": "Initial zoom level"
        },
        "stops": {
          "description": "Dispatch route/template stops array or template expression. Used when markers is not supplied.",
          "oneOf": [
            { "type": "array", "items": { "type": "object", "additionalProperties": true } },
            { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
          ]
        },
        "markers": {
          "description": "Explicit marker array or template expression. Takes precedence over stops.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "oneOf": [{ "type": "string" }, { "type": "number" }]
                  },
                  "number": {
                    "oneOf": [{ "type": "string" }, { "type": "number" }]
                  },
                  "label": {
                    "type": "string"
                  },
                  "lat": {
                    "oneOf": [{ "type": "number" }, { "type": "string" }, { "type": "null" }]
                  },
                  "lng": {
                    "oneOf": [{ "type": "number" }, { "type": "string" }, { "type": "null" }]
                  },
                  "address": {
                    "type": ["string", "null"]
                  },
                  "stopType": {
                    "type": ["string", "null"]
                  },
                  "color": {
                    "type": "string",
                    "description": "Pin color: a CSS color (e.g. \"#1e88e5\", \"teal\") or a theme palette key (primary, secondary, success, warning, error, info). Defaults to the standard pin color."
                  },
                  "text": {
                    "type": "string",
                    "description": "Short text shown inside the pin instead of the sequence number (e.g. a stop code or an initial)."
                  }
                },
                "additionalProperties": true
              }
            },
            { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
          ]
        },
        "paths": {
          "description": "Polylines drawn on the map (e.g. a recorded GPS track or a planned route), or a template expression that resolves to such an array. Path points are included in fitBounds.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "points": {
                    "description": "Ordered path points, or a template expression that resolves to them.",
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "lat": { "type": "number", "description": "Latitude" },
                            "lng": { "type": "number", "description": "Longitude" },
                            "recordedAt": {
                              "type": "string",
                              "description": "ISO 8601 time the point was recorded. Used by gapMinutes to detect gaps."
                            }
                          },
                          "required": ["lat", "lng"],
                          "additionalProperties": true
                        }
                      },
                      { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
                    ]
                  },
                  "color": {
                    "type": "string",
                    "default": "primary",
                    "description": "Line color: a CSS color (e.g. \"#1e88e5\", \"teal\") or a theme palette key (primary, secondary, success, warning, error, info)."
                  },
                  "width": {
                    "oneOf": [
                      { "type": "number", "minimum": 0 },
                      { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
                    ],
                    "default": 4,
                    "description": "Line width in pixels"
                  },
                  "dashed": {
                    "oneOf": [
                      { "type": "boolean" },
                      { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
                    ],
                    "default": false,
                    "description": "Draw the whole path as a dashed line"
                  },
                  "gapMinutes": {
                    "oneOf": [
                      { "type": "number", "minimum": 0 },
                      { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
                    ],
                    "description": "When two consecutive points are more than this many minutes apart (by recordedAt), they are joined by a dashed warning-colored segment that marks the gap in the data. Omit to draw every segment the same way."
                  },
                  "label": {
                    "type": "string",
                    "description": "Path name (e.g. \"Shift track\")"
                  }
                },
                "required": ["points"],
                "additionalProperties": true
              }
            },
            { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
          ]
        },
        "fitBounds": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
          ],
          "default": true,
          "description": "Automatically fit the map bounds to valid markers when no explicit center is supplied"
        },
        "showUnmappedNote": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
          ],
          "default": true,
          "description": "Show a caption listing markers/stops that could not be plotted"
        },
        "showInfoWindow": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
          ],
          "default": true,
          "description": "Open an info window when a marker is clicked"
        },
        "refreshInterval": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string", "pattern": "\\{\\{.*\\}\\}" }
          ],
          "description": "Refresh the map's data every N seconds (e.g. to follow a live GPS track). Omit or 0 to disable."
        },
        "onMarkerClick": {
          "$ref": "../schemas.json#/definitions/actionsList",
          "description": "Actions fired when a marker is clicked. Receives the marker as result."
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["component"],
  "x-examples": [
    {
      "component": "map",
      "name": "dispatchRouteMap",
      "props": {
        "height": 560,
        "stops": "{{ dispatchRoute.stops }}",
        "fitBounds": true,
        "onMarkerClick": [
          { "setStore": { "selectedStopId": "{{ result.id }}" } }
        ]
      }
    },
    {
      "component": "map",
      "name": "terminalMap",
      "props": {
        "height": 420,
        "center": { "lat": 33.749, "lng": -84.388 },
        "zoom": 8,
        "markers": [
          {
            "id": "atl",
            "label": "Atlanta Terminal",
            "lat": 33.749,
            "lng": -84.388,
            "address": "Atlanta, GA"
          }
        ]
      }
    },
    {
      "component": "map",
      "name": "shiftTrackMap",
      "props": {
        "height": 480,
        "refreshInterval": 60,
        "paths": [
          {
            "points": "{{ shiftTrack.points }}",
            "color": "primary",
            "width": 4,
            "gapMinutes": 10,
            "label": "Shift track"
          }
        ],
        "markers": [
          { "id": "start", "label": "Clocked in", "lat": 33.749, "lng": -84.388, "color": "success", "text": "S" },
          { "id": "now", "label": "Last position", "lat": 33.79, "lng": -84.32, "color": "#e53935", "text": "D" }
        ]
      }
    }
  ]
}
