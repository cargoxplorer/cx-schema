{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Card Component",
  "description": "MUI Card surface with an optional header row. With onClick it becomes an accessible interactive card (Enter/Space activate it).",
  "type": "object",
  "properties": {
    "component": {
      "type": "string",
      "const": "card"
    },
    "name": {
      "type": "string",
      "description": "Unique name identifier for the card; sent as the sender of onClick actions"
    },
    "props": {
      "type": ["object", "null"],
      "description": "Card props. An empty props key (null) renders a plain card",
      "properties": {
        "permission": {
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }],
          "description": "Permission(s) required to render the card"
        },
        "className": {
          "type": "string",
          "description": "CSS classes on the card root"
        },
        "options": {
          "type": "object",
          "description": "Card visual and layout options",
          "properties": {
            "variant": {
              "type": "string",
              "enum": ["elevation", "outlined"],
              "description": "MUI Card variant"
            },
            "elevation": {
              "type": "number",
              "description": "Shadow depth when variant is elevation"
            },
            "sx": {
              "type": "object",
              "description": "MUI sx styles applied to the card root",
              "additionalProperties": true
            },
            "style": {
              "type": "object",
              "description": "Theme-aware CSSProperties applied after sx",
              "properties": {
                "light": {
                  "type": "object",
                  "description": "Card root styles for light mode",
                  "additionalProperties": true
                },
                "dark": {
                  "type": "object",
                  "description": "Card root styles for dark mode",
                  "additionalProperties": true
                }
              },
              "additionalProperties": false
            },
            "bgcolor": {
              "type": "string",
              "description": "Background color"
            },
            "color": {
              "type": "string",
              "description": "Text color"
            },
            "className": {
              "type": "string",
              "description": "CSS classes for the card root"
            },
            "header": {
              "type": "object",
              "description": "Renders a header row. A section heading belongs here, not in a text component above the card",
              "properties": {
                "title": {
                  "type": ["string", "object"],
                  "description": "Header title: string, template or localized map ({ en-US: ... })"
                },
                "titleType": {
                  "type": "string",
                  "enum": ["h1", "h2", "h3", "h4", "h5", "h6"],
                  "description": "Renders the title as a section heading of that level, like a text of that type. Without it the title keeps the small card-header style"
                },
                "subheader": {
                  "type": ["string", "object"],
                  "description": "Line under the title: string, template or localized map"
                },
                "icon": {
                  "type": "string",
                  "description": "Header avatar icon, e.g. tabler-map-pin. May be a template"
                },
                "iconColor": {
                  "type": "string",
                  "description": "Icon color. Default text.secondary"
                },
                "badge": {
                  "type": "object",
                  "description": "badge component props, rendered right after the title (e.g. a status). Nothing renders when the label resolves empty",
                  "required": ["label"],
                  "properties": {
                    "label": {
                      "type": ["string", "number", "object"],
                      "description": "Badge text, usually a template"
                    }
                  },
                  "additionalProperties": true
                },
                "action": {
                  "type": "array",
                  "description": "Components rendered on the right of the header row, e.g. a dropdown Actions menu or a stats amount",
                  "items": {
                    "type": "object",
                    "required": ["component"],
                    "properties": {
                      "component": { "type": "string" }
                    },
                    "additionalProperties": true
                  }
                },
                "sx": {
                  "type": "object",
                  "description": "MUI sx styles on the header",
                  "additionalProperties": true
                }
              },
              "additionalProperties": false
            },
            "actions": {
              "type": "object",
              "description": "Renders an empty CardActions row (padding only) styled by sx",
              "properties": {
                "sx": { "type": "object", "additionalProperties": true }
              },
              "additionalProperties": true
            },
            "disableContentWrapper": {
              "type": "boolean",
              "description": "Render children directly without CardContent"
            },
            "contentSx": {
              "type": "object",
              "description": "MUI sx styles applied to CardContent",
              "additionalProperties": true
            },
            "contentClassName": {
              "type": "string",
              "description": "CSS class applied to CardContent (default: card-content)"
            },
            "contentProps": {
              "type": "object",
              "description": "Additional CardContent props",
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "onClick": {
          "type": "array",
          "description": "Actions to execute when the card is clicked or activated with Enter/Space",
          "items": { "type": "object" }
        }
      }
    },
    "children": {
      "type": "array",
      "description": "Components rendered inside the card",
      "items": {
        "type": "object",
        "required": ["component"]
      }
    }
  },
  "required": ["component"],
  "x-examples": [
    {
      "component": "card",
      "name": "invoiceCard",
      "props": {
        "options": {
          "header": {
            "title": "Invoice {{ invoiceForm.transactionNumber }}",
            "titleType": "h2",
            "subheader": "{{ invoiceForm.division.name }}",
            "badge": {
              "label": "{{ invoiceForm.accountingTransactionStatus }}",
              "options": { "colors": { "open": "primary", "paid": "success" } }
            },
            "action": [
              {
                "component": "stats",
                "props": {
                  "size": "lg",
                  "align": "end",
                  "items": [{ "label": "Amount Due", "value": "{{ format invoiceForm.amountDue currency USD }}" }]
                }
              }
            ]
          }
        }
      },
      "children": [
        {
          "component": "layout",
          "props": { "cols": 2 },
          "children": [{ "component": "text", "props": { "value": "..." } }]
        }
      ]
    },
    {
      "component": "card",
      "name": "ordersTile",
      "props": {
        "className": "p-2",
        "onClick": [{ "navigate": "orders" }]
      },
      "children": [
        {
          "component": "layout",
          "props": { "className": "d-flex justify-content-between p-3", "cols": 0 },
          "children": [
            { "component": "icon", "props": { "icon": "briefcase" } },
            { "component": "text", "props": { "value": { "en-US": "Orders" } } }
          ]
        }
      ]
    }
  ]
}
