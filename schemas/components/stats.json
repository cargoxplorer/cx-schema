{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stats-component",
  "title": "Stats Component",
  "description": "Read-only totals, counts, and headline values.",
  "type": "object",
  "required": ["component", "props"],
  "properties": {
    "component": { "type": "string", "const": "stats" },
    "name": { "type": "string" },
    "props": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "oneOf": [{ "type": "string" }, { "$ref": "../schemas.json#/definitions/localized" }] },
              "value": {},
              "unit": {},
              "caption": { "oneOf": [{ "type": "string" }, { "$ref": "../schemas.json#/definitions/localized" }] },
              "decimals": { "type": "number", "minimum": 0 },
              "emphasis": { "type": "boolean" },
              "icon": { "type": "string", "description": "Cards and chips variants: Tabler icon name or template." },
              "color": {
                "type": "string",
                "enum": ["primary", "secondary", "success", "info", "warning", "error"],
                "default": "primary",
                "description": "Cards and chips variants: icon tile color."
              }
            },
            "additionalProperties": false
          }
        },
        "variant": { "type": "string", "enum": ["row", "list", "cards", "chips"], "default": "row" },
        "size": { "type": "string", "enum": ["sm", "md", "lg"], "default": "md", "description": "Value or card density; cards support compact sm sizing" },
        "align": { "type": "string", "enum": ["start", "end"], "default": "start", "description": "Row and chips variants: horizontal alignment" },
        "className": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
