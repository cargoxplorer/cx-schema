{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Attachment Tasks",
  "description": "Attachment entity CRUD operations and entity links",
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "enum": [
        "Attachment/Create@1",
        "Attachment/Update@1",
        "Attachment/Link@1",
        "Attachment/Unlink@1",
        "Attachment/Delete@1",
        "Attachment/Get@1",
        "Attachment/Thumbnail",
        "Attachment/PdfThumbnail",
        "Attachment/RegenerateThumbnails"
      ],
      "description": "Task type identifier"
    },
    "name": {
      "type": "string",
      "description": "Step name identifier"
    },
    "description": {
      "type": "string",
      "description": "Step description"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string"
          }
        },
        "required": ["expression"]
      }
    },
    "continueOnError": {
      "type": "boolean"
    },
    "inputs": {
      "type": "object",
      "description": "Attachment operation inputs",
      "properties": {
        "attachmentId": {
          "type": "string",
          "description": "Attachment ID"
        },
        "attachment": {
          "type": "object",
          "description": "Attachment values (Attachment/Create@1, Attachment/Update@1)",
          "properties": {
            "fileName": {
              "type": "string"
            },
            "attachmentType": {
              "type": "string",
              "description": "Picture, OtherDocument, Avatar, CustomerDocument"
            },
            "description": {
              "type": "string"
            },
            "parentType": {
              "type": "string",
              "description": "Primary parent type: Order, Contact, AccountingTransaction, EquipmentType, Job, Commodity, Route, TrackingEvent"
            },
            "parentId": {
              "type": "string",
              "description": "Primary parent ID"
            },
            "links": {
              "type": "array",
              "description": "Additional entity links on create (Attachment/Create@1)",
              "items": {
                "type": "object",
                "properties": {
                  "entityType": {
                    "type": "string",
                    "description": "Linked entity type: Order, Contact, Job, TrackingEvent"
                  },
                  "entityId": {
                    "type": "string",
                    "description": "Linked entity ID (int id; uuid for Job)"
                  }
                },
                "required": ["entityType", "entityId"]
              }
            }
          },
          "additionalProperties": true
        },
        "fileData": {
          "description": "File content: base64 string, byte array or stream (Attachment/Create@1)"
        },
        "fileUrl": {
          "type": "string",
          "description": "URL to download the file from (Attachment/Create@1)"
        },
        "entityName": {
          "type": "string",
          "description": "Parent entity name"
        },
        "entityType": {
          "type": "string",
          "description": "Entity type to link/unlink: Order, Contact, Job, TrackingEvent (Attachment/Link@1, Attachment/Unlink@1)"
        },
        "entityId": {
          "type": "string",
          "description": "Entity ID to link/unlink: int id, uuid for Job (Attachment/Link@1, Attachment/Unlink@1)"
        },
        "fileName": {
          "type": "string",
          "description": "Attachment file name"
        },
        "content": {
          "type": "string",
          "description": "File content (base64)"
        },
        "contentType": {
          "type": "string",
          "description": "MIME content type"
        },
        "entity": {
          "type": "object",
          "description": "Attachment entity data",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "mapping": {
            "type": "string"
          }
        },
        "required": ["name", "mapping"]
      }
    }
  },
  "required": ["task"],
  "additionalProperties": true
}
