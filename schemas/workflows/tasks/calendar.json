{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Calendar Tasks",
  "description": "Issue and import iCalendar feed links",
  "type": "object",
  "properties": {
    "task": { "type": "string", "enum": ["Calendar/IssueLink@1", "Calendar/ImportFeed@1"] },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "conditions": { "type": "array" },
    "continueOnError": { "type": "boolean" },
    "inputs": {
      "type": "object",
      "properties": {
        "organizationId": {}, "calendarId": {}, "label": {},
        "organizationConnectionId": {}, "url": {}, "etag": {}
      },
      "required": ["organizationId"],
      "additionalProperties": true
    },
    "outputs": { "type": "array" }
  },
  "required": ["task", "name", "inputs"],
  "additionalProperties": true
}
